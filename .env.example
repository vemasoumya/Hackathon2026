FOUNDRY_PROJECT_ENDPOINT="https://<your-foundry>.services.ai.azure.com/api/projects/<your-project>"
FOUNDRY_MODEL_DEPLOYMENT_NAME="gpt-5.4"
FOUNDRY_EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-small"
# Optional: use an existing Copilot CLI executable instead of downloading one.
COPILOT_CLI_PATH="C:\\Petronas\\Installation\\copilot-win32-x64\\copilot.exe"
COPILOT_MODEL="gpt-5.4"
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_KEY="<your-cosmos-key>"
ENABLE_LOCAL_AUDIT=true
ENABLE_AUDIT_RESPONSE_BODY=true
ENABLE_AUDIT_PROMPT_BODY=true
AUDIT_BACKEND=cosmos  # Use cosmos for production
AUDIT_COSMOS_ENDPOINT=https://localhost:8081
AUDIT_COSMOS_KEY="<your-cosmos-key>"
AUDIT_COSMOS_DATABASE=hackathon2026
AUDIT_COSMOS_CONTAINER=audit_records
AUDIT_CONTEXT_CONTAINER=context_records
AUDIT_OUTPUT_CONTAINER=output_records
